{
    // IntelliSense for the Microsoft C/C++ extension. CodeLLDB ignores this
    // file; its code completion works out of the box once build-debug/ exists
    // (it also reads compile_commands.json when the clangd extension is used).
    "configurations": [
        {
            "name": "Linux",
            "compilerPath": "/usr/bin/g++",
            // compile_commands.json is generated by the CMake configure step;
            // it appears after the first F5 or `make debug`. Until then the
            // includePath/defines below are used.
            "compileCommands": "${workspaceFolder}/build-debug/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/third_party",
                "${workspaceFolder}/third_party/nlohmann",
                "${workspaceFolder}/third_party/doctest"
            ],
            "defines": ["CPPHTTPLIB_THREAD_POOL_COUNT=32"],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}
